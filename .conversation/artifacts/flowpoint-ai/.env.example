# Public client-side configuration. Set these as Replit secrets/env vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Automation webhooks used by the email/task, agent, and policy assistant flows.
VITE_WEBHOOK_SEND_EMAIL=
VITE_WEBHOOK_AGENT=
VITE_WEBHOOK_POLICIES_CHAT=

# Replit supplies these for the managed app workflow. Set them manually only
# when running Vite outside that workflow.
PORT=5000
BASE_PATH=/